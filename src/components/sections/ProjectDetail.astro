---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate, getLocalePath, t, type Lang } from '../../i18n/ui';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';
import Shields from '../ui/Shields.astro';
import { shields } from '../../config/shields';
import { links } from '../../config/site';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}

const { lang, project } = Astro.props;
const { title, date, summary, github } = project.data;
const { Content } = await render(project);
---

<Section size="lg">
  <a class="back" href={getLocalePath(lang, '/projects')}>
    <span aria-hidden="true">←</span>
    {t(lang, 'projects.back')}
  </a>

  <header class="header">
    <h1 class="title">{title}</h1>
    {github && <Shields repo={github.repo} url={github.url} names={github.shields} />}
    <p class="summary">{summary}</p>
  </header>

  <Prose>
    <Content />
    {
      github?.avatars && (
        <>
          <h2>{t(lang, 'projects.contributors')}</h2>
          <div>
            <ExternalLink href={`${github.url}${shields.contributors.href}`}>
              <img
                class="contributors-faces"
                src={`${links.contribRocks}?repo=${github.repo}&columns=10`}
                alt={t(lang, 'projects.contributors.avatars')}
                loading="lazy"
                decoding="async"
              />
            </ExternalLink>
          </div>
        </>
      )
    }
  </Prose>

  <p class="meta">
    {
      github && (
        <>
          <ExternalLink href={github.url} hint>
            <Icon name="github" />
            {t(lang, 'projects.repo')}
          </ExternalLink>
          <span aria-hidden="true">·</span>
        </>
      )
    }
    <span class="date">
      <Icon name="clock" />
      {t(lang, 'projects.date')}
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(lang, date)}</time>
    </span>
  </p>
</Section>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-tight);
    font-size: var(--fs-base);
    font-weight: var(--weight-medium);
    color: var(--muted);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .header {
    margin: var(--space-6) 0 var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    max-width: var(--measure-prose);
  }

  .title {
    margin: 0;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
  }

  .summary {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    color: var(--muted);
    text-wrap: pretty;
  }

  .contributors-faces {
    display: block;
    max-width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-tight);
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--line);
    font-size: var(--fs-md);
    font-weight: var(--weight-medium);
  }

  .meta :global(a),
  .date {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-tight);
  }

  .date {
    color: var(--muted);
  }
</style>
