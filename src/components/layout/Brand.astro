---
import { getLocalePath, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a href={getLocalePath(lang, '/')} class="brand">
  <svg
    class="mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 48 48"
    fill="none"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 14 L4 24 L12 34" class="mark__accent" />
    <path d="M36 14 L44 24 L36 34" class="mark__signal" />
    <path d="M20.5 43 L22.8 24 H25.2 L27.5 43 Z" class="mark__tower" stroke-width="1.5" />
    <path d="M18.5 14 H29.5 L27.5 23 H20.5 Z" class="mark__tower" stroke-width="2" />
    <path d="M24 12 V4" class="mark__tower" stroke-width="3" />
  </svg>
  <span class="wordmark">{t(lang, 'nav.brand')}</span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: var(--gap);
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .mark {
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
  }

  .mark__accent {
    stroke: var(--accent-fill);
  }

  .mark__signal {
    stroke: var(--signal-fill);
  }

  .mark__tower {
    fill: var(--fg);
    stroke: var(--fg);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }
</style>
