---
import { getLocalePath, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a href={getLocalePath(lang, '/')} class="brand">
  <img src="/logo-light.svg" alt="" class="mark mark--light" aria-hidden="true" />
  <img src="/logo-dark.svg" alt="" class="mark mark--dark" aria-hidden="true" />
  <span class="wordmark">{t(lang, 'nav.brand')}</span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: var(--gap);
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .mark {
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
  }

  .mark--dark {
    display: none;
  }

  :global([data-theme='dark']) .mark--light {
    display: none;
  }

  :global([data-theme='dark']) .mark--dark {
    display: block;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }
</style>
